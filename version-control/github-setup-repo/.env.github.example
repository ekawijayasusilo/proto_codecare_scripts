# Secrets & variables for setup-github-repo.sh --secrets-file
# Copy to .env.github (gitignored) and fill in. NEVER commit real values.
#
# Each [section] holds dotenv lines (KEY=value). Sections:
#   [actions.secret]  [actions.var]        repository-level GitHub Actions
#   [env:NAME.secret] [env:NAME.var]       Actions environment NAME (created if missing)
#   [dependabot.secret]                    Dependabot (secrets only)
#   [codespaces.secret]                    Codespaces (secrets only)
# Multi-line values: wrap in double quotes.

[actions.secret]
NPM_TOKEN=replace-me

[actions.var]
NODE_VERSION=22

[env:production.secret]
DEPLOY_KEY=replace-me

[env:production.var]
API_URL=https://api.example.com

[dependabot.secret]
NPM_TOKEN=replace-me

[codespaces.secret]
DEV_API_KEY=replace-me
